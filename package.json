{
  "name": "contextparcel",
  "version": "0.1.0",
  "description": "Local-first context handoff from web AI conversations to coding agents.",
  "type": "module",
  "license": "MIT",
  "author": "AIM135D",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIM135D/contextparcel.git"
  },
  "homepage": "https://github.com/AIM135D/contextparcel#readme",
  "bugs": "https://github.com/AIM135D/contextparcel/issues",
  "bin": {
    "contextparcel": "dist/contextparcel.cjs"
  },
  "files": [
    "dist/contextparcel.cjs",
    "docs/handoff-packet.schema.json",
    "examples/sample-handoff",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:extension",
    "build:cli": "esbuild apps/cli/src/index.ts --bundle --platform=node --format=cjs --target=node20 --banner:js='#!/usr/bin/env node' --outfile=dist/contextparcel.cjs && node scripts/mark-cli-executable.mjs",
    "build:extension": "vite build --config apps/extension/vite.config.ts && node scripts/package-extension.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "codex",
    "claude-code",
    "cursor",
    "context",
    "handoff",
    "browser-extension",
    "local-first"
  ],
  "dependencies": {
    "commander": "^14.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.2.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
